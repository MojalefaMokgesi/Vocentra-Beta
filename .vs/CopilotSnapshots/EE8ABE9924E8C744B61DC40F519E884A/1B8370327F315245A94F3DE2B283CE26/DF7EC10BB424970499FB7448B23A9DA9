@model Vocentra.ViewModels.AccountSettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="card" style="max-width:900px;margin:0 auto;padding:20px;">
    <h2 style="margin-top:0;">Account Settings</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div style="display:flex;gap:2rem;align-items:center;margin-bottom:1rem;">
        <div style="flex:1;">
            <label class="form-label">Email</label>
            <input class="form-control" value="@Model.Email" readonly />
            <small class="text-muted">Your account email (read-only)</small>
        </div>
        <div style="width:220px;text-align:right;">
            <div style="font-weight:700;font-size:1.25rem;">@Model.ProfileCompletion% complete</div>
            <div style="font-size:0.85rem;color:#666;">Profile completion</div>
        </div>
    </div>

    <div style="display:flex;gap:2rem;">
        <div style="flex:1;">
            <form asp-action="Settings" method="post">
                <validation-summary />

                <div class="mb-3">
                    <label class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Company</label>
                    <input asp-for="CompanyName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <div class="form-text">South African numbers only (e.g. 0821234567 or +27821234567)</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Notifications</label>
                    <div class="form-check">
                        <input asp-for="EmailNotifications" class="form-check-input" />
                        <label class="form-check-label">Email notifications</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="JobAlerts" class="form-check-input" />
                        <label class="form-check-label">Job alerts</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>

        <div style="width:280px;">
            <div class="card" style="padding:12px;margin-bottom:12px;">
                <div style="font-weight:600">Email verification</div>
                <div style="margin-top:8px;">@((Model.EmailVerified) ? "Verified" : "Not verified")</div>
                @if (!Model.EmailVerified)
                {
                    <form asp-action="ResendEmailVerification" method="post" style="margin-top:10px;">
                        <button type="submit" class="btn btn-link">Resend verification email</button>
                    </form>
                }
            </div>

            <div class="card" style="padding:12px;">
                <div style="font-weight:600">Account actions</div>
                <div style="margin-top:8px;">You can temporarily deactivate your account.</div>
                <form asp-action="Deactivate" method="post" style="margin-top:10px;">
                    <button type="submit" class="btn btn-danger">Deactivate account</button>
                </form>
            </div>
        </div>
    </div>
    
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
