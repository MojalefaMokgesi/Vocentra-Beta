using System;
using System.IO;
using System.Security.Cryptography;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Hosting;
using Vocentra.Models;

namespace Vocentra.Services
{
    public class LocalProofStorageService : IProofStorageService
    {
        private readonly string _basePath;

        public LocalProofStorageService(IHostEnvironment env, IConfiguration cfg)
        {
            // Default to App_Data/Proofs inside content root
            _basePath = Path.Combine(env.ContentRootPath, "App_Data", "Proofs");
            Directory.CreateDirectory(_basePath);
        }

        public async Task<ProofDocument> SaveAsync(IFormFile file)
        {
            var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.FileName);
            var storedPath = Path.Combine(_basePath, fileName);

            using (var fs = new FileStream(storedPath, FileMode.CreateNew))
            {
                await file.CopyToAsync(fs);
            }

            // compute sha256
            string sha256;
            using (var sha = SHA256.Create())
            using (var fs = new FileStream(storedPath, FileMode.Open, FileAccess.Read))
            {
                var hash = sha.ComputeHash(fs);
                sha256 = Convert.ToHexString(hash);
            }

            var doc = new ProofDocument
            {
                StorageProvider = StorageProvider.Local,
                StoredPathOrBlobKey = storedPath,
                OriginalFileName = file.FileName,
                ContentType = file.ContentType,
                SizeBytes = file.Length,
                Sha256 = sha256,
                UploadedAt = DateTime.UtcNow
            };

            return doc;
        }

        public Task<Stream> GetStreamAsync(ProofDocument doc)
        {
            if (doc.StorageProvider != StorageProvider.Local)
                throw new InvalidOperationException("Document is not stored locally");

            var path = doc.StoredPathOrBlobKey;
            var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
            return Task.FromResult((Stream)fs);
        }
    }
}
