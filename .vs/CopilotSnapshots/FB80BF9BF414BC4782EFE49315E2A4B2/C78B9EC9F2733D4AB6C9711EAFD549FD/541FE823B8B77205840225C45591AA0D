using System;
using System.IO;
using System.Security.Cryptography;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Hosting;
using Vocentra.Models;

namespace Vocentra.Services
{
    public class LocalProofStorageService : IProofStorageService
    {
        private readonly string _basePath;
        private readonly Microsoft.AspNetCore.DataProtection.IDataProtector _protector;

        public LocalProofStorageService(IHostEnvironment env, IConfiguration cfg, Microsoft.AspNetCore.DataProtection.IDataProtectionProvider dp)
        {
            // Default to App_Data/Proofs inside content root
            _basePath = Path.Combine(env.ContentRootPath, "App_Data", "Proofs");
            Directory.CreateDirectory(_basePath);
            _protector = dp.CreateProtector("ProofDownloadToken");
        }

        public async Task<ProofDocument> SaveAsync(IFormFile file)
        {
            var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.FileName);
            var storedPath = Path.Combine(_basePath, fileName);

            using (var fs = new FileStream(storedPath, FileMode.CreateNew))
            {
                await file.CopyToAsync(fs);
            }

            // compute sha256
            string sha256;
            using (var sha = SHA256.Create())
            using (var fs = new FileStream(storedPath, FileMode.Open, FileAccess.Read))
            {
                var hash = sha.ComputeHash(fs);
                sha256 = Convert.ToHexString(hash);
            }

            var doc = new ProofDocument
            {
                StorageProvider = StorageProvider.Local,
                StoredPathOrBlobKey = storedPath,
                OriginalFileName = file.FileName,
                ContentType = file.ContentType,
                SizeBytes = file.Length,
                Sha256 = sha256,
                UploadedAt = DateTime.UtcNow
            };

            return doc;
        }

        public Task<Stream> GetStreamAsync(ProofDocument doc)
        {
            if (doc.StorageProvider != StorageProvider.Local)
                throw new InvalidOperationException("Document is not stored locally");

            var path = doc.StoredPathOrBlobKey;
            var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
            return Task.FromResult((Stream)fs);
        }

        public Task<string> CreateDownloadTokenAsync(ProofDocument doc, TimeSpan validFor)
        {
            var payload = new
            {
                doc.StorageProvider,
                doc.StoredPathOrBlobKey,
                doc.OriginalFileName,
                doc.ContentType,
                Expiry = DateTime.UtcNow.Add(validFor)
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var token = _protector.Protect(json);
            return Task.FromResult(token);
        }

        public Task<Stream> GetStreamFromDownloadTokenAsync(string token)
        {
            try
            {
                var json = _protector.Unprotect(token);
                var doc = System.Text.Json.JsonSerializer.Deserialize<DownloadTokenPayload>(json);
                if (doc == null) throw new InvalidOperationException("Invalid token payload");
                if (doc.Expiry < DateTime.UtcNow) throw new InvalidOperationException("Token expired");
                if (doc.StorageProvider != StorageProvider.Local) throw new InvalidOperationException("Token not for local storage");

                var fs = new FileStream(doc.StoredPathOrBlobKey, FileMode.Open, FileAccess.Read, FileShare.Read);
                return Task.FromResult((Stream)fs);
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException("Invalid or expired token", ex);
            }
        }

        private class DownloadTokenPayload
        {
            public StorageProvider StorageProvider { get; set; }
            public string StoredPathOrBlobKey { get; set; } = string.Empty;
            public string OriginalFileName { get; set; } = string.Empty;
            public string ContentType { get; set; } = string.Empty;
            public DateTime Expiry { get; set; }
        }
    }
}
