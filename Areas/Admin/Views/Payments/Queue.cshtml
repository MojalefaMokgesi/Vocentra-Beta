@model IEnumerable<Vocentra.Models.PaymentRequest>
@{
    ViewData["Title"] = "Payment Queue";
}
<h2>Payment Queue</h2>
<table class="table">
    <thead>
        <tr><th>Id</th><th>Job</th><th>Amount</th><th>Status</th><th>Submitted</th><th>Actions</th></tr>
    </thead>
    <tbody>
@foreach(var p in Model) {
    <tr>
        <td>@p.Id</td>
        <td>@p.Job?.Title</td>
        <td>@p.Amount.ToString("C")</td>
        <td>@p.Status</td>
        <td>@p.CreatedAt.ToLocalTime()</td>
        <td>
            <a asp-area="Admin" asp-controller="Payments" asp-action="Review" asp-route-id="@p.Id" class="btn btn-sm btn-primary">Review</a>
        </td>
    </tr>
}
    </tbody>
</table>
