@model IEnumerable<Vocentra.Models.PaymentRequest>
@{
    ViewData["Title"] = "Payment Queue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Payment Queue</h2>
    <div>
        <a class="btn btn-sm btn-outline-light" asp-area="Admin" asp-controller="Payments" asp-action="Queue">Refresh</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th>Id</th>
                <th>Job</th>
                <th>Reference</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Proof</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            var latest = p.Submissions?.OrderByDescending(s => s.SubmittedAt).FirstOrDefault();
            <tr>
                <td>@p.Id</td>
                <td>
                    @if (p.Job != null)
                    {
                        <div>@p.Job.Title</div>
                        <small class="text-muted">Job #@p.JobId</small>
                    }
                </td>
                <td>@p.Reference</td>
                <td>@p.Amount.ToString("C")</td>
                <td>
                    <span class="badge bg-info text-dark">@p.Status</span>
                </td>
                <td>@p.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
                    @if (latest?.Document != null)
                    {
                        <a asp-area="Admin" asp-controller="Payments" asp-action="DownloadDocument" asp-route-docId="@latest.Document.Id" class="btn btn-sm btn-outline-light">View</a>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <a asp-area="Admin" asp-controller="Payments" asp-action="Review" asp-route-id="@p.Id" class="btn btn-sm btn-primary">Review</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No payment requests found.</div>
}
