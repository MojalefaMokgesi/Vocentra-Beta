@model IEnumerable<Vocentra.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}

<h2>Audit Log</h2>
<div class="content-card">
    <table class="table table-dark table-striped">
        <thead>
            <tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Notes</th></tr>
        </thead>
        <tbody>
        @foreach(var a in Model){
            <tr>
                <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                <td>@a.ActorUserId (@a.ActorRole)</td>
                <td>@a.Action</td>
                <td>@a.EntityType #@a.EntityId</td>
                <td>@a.MetadataJson</td>
            </tr>
        }
        </tbody>
    </table>
</div>