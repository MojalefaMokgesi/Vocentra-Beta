<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      Enable stdout logging so startup exceptions are visible in App Service Log Stream.
      stdoutLogFile uses the Azure LogFiles folder. Do NOT leave stdout logging enabled in long-term production
      because logs can grow large. Use App Service Diagnostics/Log Stream and Application Insights for production.
    -->
    <aspNetCore processPath="dotnet" arguments=".\Vocentra.dll" stdoutLogEnabled="true" stdoutLogFile="\\?\%home%\LogFiles\stdout" hostingModel="OutOfProcess" />
  </system.webServer>
</configuration>
