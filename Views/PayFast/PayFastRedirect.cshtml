@model IDictionary<string, string>

@{
    Layout = null;
    var processUrl = (string)ViewBag.ProcessUrl;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Redirecting to PayFast...</title>
</head>
<body>
    <form id="pfForm" action="@processUrl" method="post">
        @* IMPORTANT: Only PayFast fields, no asp-* tag helpers, no AntiForgeryToken *@
        @foreach (var kv in Model)
        {
            <input type="hidden" name="@kv.Key" value="@kv.Value" />
        }

        <noscript>
            <button type="submit">Continue to PayFast</button>
        </noscript>
    </form>

    <script>
        document.getElementById('pfForm').submit();
    </script>
</body>
</html>
